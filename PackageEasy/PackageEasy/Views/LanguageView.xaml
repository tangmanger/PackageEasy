<UserControl x:Class="PackageEasy.Views.LanguageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PackageEasy.Views"
             xmlns:lang="clr-namespace:PackageEasy.Common.Data;assembly=PackageEasy.Common"
             xmlns:other="clr-namespace:PackageEasy.Views.OtherViews"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource appCanvasBrush}">
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="0"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <!--页头-->
            <TextBlock Text="{DynamicResource ProjectLanguage}" Style="{StaticResource PageHeaderStyle}"></TextBlock>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Visibility="Collapsed">
                <RadioButton Content="语言编辑" x:Name="langModify" lang:LanguageManager.LangText="语言编辑" FontSize="16" MinWidth="80" Template="{StaticResource LanguageTabTemplate}" HorizontalContentAlignment="Center"></RadioButton>
                <RadioButton Content="文件设置" IsChecked="True" lang:LanguageManager.LangText="文件设置" FontSize="16" MinWidth="80" Template="{StaticResource LanguageTabTemplate}" Margin="5,0,0,0"></RadioButton>
            </StackPanel>

            <!--暂未实现的语言编辑页-->
            <Grid Grid.Row="2" Visibility="{Binding Path=IsChecked,ElementName=langModify,Converter={StaticResource BoolToVisibilityConverter}}">
                <!--<other:LanguageEditView ></other:LanguageEditView>-->
            </Grid>

            <!--文件设置-->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,16,0,0">
                <other:LanguageFileView></other:LanguageFileView>
            </Border>
        </Grid>
    </Grid>
</UserControl>
