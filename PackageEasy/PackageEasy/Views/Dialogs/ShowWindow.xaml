<Window x:Class="PackageEasy.Views.Dialogs.ShowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:PackageEasy.Views.Dialogs"
        mc:Ignorable="d"
        xmlns:lang="clr-namespace:PackageEasy.Common.Data;assembly=PackageEasy.Common"
        ShowInTaskbar="False"
        AllowsTransparency="False" WindowStyle="None"  Background="{DynamicResource MainWorkAreaBackgroud}" Foreground="{DynamicResource mainForeground}" Loaded="Window_Loaded" Height="440" Width="660"
        WindowStartupLocation="CenterOwner">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Unload">
            <i:InvokeCommandAction Command="{Binding UnloadCommand}"></i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      GlassFrameThickness="0,0,0,1"
                      NonClientFrameEdges="None"
                      CornerRadius="8"
                      ResizeBorderThickness="3"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource appCanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="56"></RowDefinition>
            </Grid.RowDefinitions>

            <!--标题栏-->
            <Border Background="{DynamicResource shellBrush}" CornerRadius="0" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="16,0,0,0">
                        <Image Style="{StaticResource AppLogoStyle}" Width="22" Height="22"></Image>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource mainForeground}" Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}"></TextBlock>
                    </StackPanel>
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Right" Style="{StaticResource CaptionCloseButtonStyle}" FontSize="14" Command="{x:Static SystemCommands.CloseWindowCommand}" Content="&#xe607;"></Button>
                </Grid>
            </Border>

            <!--内容-->
            <Border Grid.Row="1" Background="{DynamicResource appCanvasBrush}" Padding="0">
                <ContentControl Content="{Binding WorkView}"></ContentControl>
            </Border>

            <!--底部按钮-->
            <Border Grid.Row="2" Background="{DynamicResource MainWorkAreaBackgroud}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0" CornerRadius="0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding ShowSureVisibility}" Command="{Binding SaveCommand}" Click="Button_Click" MinWidth="88" Height="32" Content="{DynamicResource Yes}"></Button>
                    <Button Style="{StaticResource CommonButtonStyle}" Margin="8,0,0,0" Click="Button_Click" MinWidth="88" Height="32" Content="{DynamicResource Cancel}"></Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
