<Window x:Class="PackageEasy.Views.Dialogs.Wating"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PackageEasy.Views.Dialogs"
        xmlns:controls="https://dicgo.com/controls"
        mc:Ignorable="d"
        Title="Wating" Height="450" Background="Transparent" IsHitTestVisible="False" ShowInTaskbar="False" Width="800" WindowStyle="None" WindowStartupLocation="CenterOwner" AllowsTransparency="True">

    <Grid Background="Transparent" IsHitTestVisible="true" PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown">
        <Border Background="{DynamicResource appCanvasBrush}" Opacity="0.1"></Border>
        <Border Background="{DynamicResource MainWorkAreaBackgroud}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="1" CornerRadius="12" Width="168" Height="84">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#000000"></DropShadowEffect>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <controls:TProgressRing Style="{StaticResource CircleProgressRingStyle}" Margin="10,0,0,0" HorizontalAlignment="Left" Width="56" Height="56" IsActive="True"></controls:TProgressRing>
                <TextBlock Margin="8,0,0,0" Text="{DynamicResource WatingTips}" FontSize="12.5" Foreground="{DynamicResource mainForeground}" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
