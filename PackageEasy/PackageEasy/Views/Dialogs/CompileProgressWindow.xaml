<Window x:Class="PackageEasy.Views.Dialogs.CompileProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        ShowInTaskbar="False"
        AllowsTransparency="False" WindowStyle="None" Background="{DynamicResource MainWorkAreaBackgroud}"
        Foreground="{DynamicResource mainForeground}"
        Height="620" Width="540"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      GlassFrameThickness="0,0,0,1"
                      NonClientFrameEdges="None"
                      CornerRadius="8"
                      ResizeBorderThickness="3"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource appCanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="56"></RowDefinition>
            </Grid.RowDefinitions>

            <!--标题栏-->
            <Border Background="{DynamicResource shellBrush}" CornerRadius="0" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="16,0,0,0">
                        <Image Style="{StaticResource AppLogoStyle}" Width="22" Height="22"></Image>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SectionHeaderStyle}" Text="{Binding Title}"></TextBlock>
                    </StackPanel>
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Right" Style="{StaticResource CaptionCloseButtonStyle}" FontSize="14" Command="{Binding CloseCommand}" Content="&#xe607;"></Button>
                </Grid>
            </Border>

            <!--内容-->
            <Border Grid.Row="1" Padding="16,14,16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <!--状态行-->
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource CompileStatusDotStyle}"></Ellipse>
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource CompileStateTextStyle}" Text="{Binding StateText}"></TextBlock>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource MonoTextStyle}" Foreground="{DynamicResource textTertiaryBrush}" Text="{Binding Progress, StringFormat={}{0:F0}%}"></TextBlock>
                    </Grid>

                    <!--进度条-->
                    <ProgressBar Grid.Row="1" Margin="0,10,0,14" Maximum="100" Value="{Binding Progress}" Style="{StaticResource LinearProgressBarStyle}"></ProgressBar>

                    <!--日志卡片-->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,0,0,1" Padding="12,0,12,0" CornerRadius="12,12,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource IconPathSmallStyle}" Data="{DynamicResource IconBolt}" Stroke="{DynamicResource Accent}"></Path>
                                    <TextBlock Margin="6,0,0,0" Style="{StaticResource SectionHeaderStyle}" FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Text="{DynamicResource CompileLogTitle}"></TextBlock>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="logList" Style="{StaticResource CompileLogListStyle}" ItemsSource="{Binding Logs}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58"></ColumnDefinition>
                                                    <ColumnDefinition></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" Style="{StaticResource CompileLogTimeTextStyle}"></TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource CompileLogTextStyle}"></TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!--空日志占位-->
                                <TextBlock Style="{StaticResource CompileEmptyLogStyle}" Text="{DynamicResource CompileWaitingLog}"></TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!--完成卡片-->
                    <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource CompileResultCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <!--结果图标-->
                            <Border Style="{StaticResource CompileResultIconBoxStyle}">
                                <Path Style="{StaticResource CompileResultIconPathStyle}"></Path>
                            </Border>
                            <!--成功信息-->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource CompileStateTextStyle}" Text="{Binding StateText}"></TextBlock>
                                <Grid Margin="0,6,0,0" Style="{StaticResource CompileSuccessInfoStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68"></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource CompileOutputFile}"></TextBlock>
                                    <TextBlock Grid.Column="1" Style="{StaticResource MonoTextStyle}" Text="{Binding OutputPath}" ToolTip="{Binding OutputPath}"></TextBlock>
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource CompileOutputSize}"></TextBlock>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource MonoTextStyle}" Text="{Binding OutputSize}"></TextBlock>
                                </Grid>
                                <!--失败摘要-->
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource CompileErrorSummaryStyle}" Text="{Binding ErrorSummary}"></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--底部按钮-->
            <Border Grid.Row="2" Background="{DynamicResource MainWorkAreaBackgroud}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0" CornerRadius="0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Style="{StaticResource CompileOpenFolderButtonStyle}" Command="{Binding OpenOutputFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSmallStyle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Data="{DynamicResource IconFolder}"></Path>
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{DynamicResource CompileOpenFolder}"></TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommonButtonStyle}" Margin="8,0,0,0" MinWidth="88" Height="32" Command="{Binding CloseCommand}" Content="{DynamicResource Close}"></Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
