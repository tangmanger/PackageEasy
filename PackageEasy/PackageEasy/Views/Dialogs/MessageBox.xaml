<Window x:Class="PackageEasy.Views.Dialogs.MessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PackageEasy.Views.Dialogs"
        WindowStartupLocation="CenterOwner"
        WindowState="Normal"
        
        AllowsTransparency="False" WindowStyle="None" Background="{DynamicResource MainWorkAreaBackgroud}"
        ShowInTaskbar="False"
        mc:Ignorable="d"
        Height="228" Width="460" MinHeight="228" MinWidth="460">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      GlassFrameThickness="0,0,0,1"
                      NonClientFrameEdges="None"
                      CornerRadius="8"
                      ResizeBorderThickness="1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource MainWorkAreaBackgroud}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <!--标题栏-->
            <Border Background="{DynamicResource shellBrush}" CornerRadius="0" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="16,0,0,0">
                        <Image Style="{StaticResource AppLogoStyle}" Width="22" Height="22"></Image>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource mainForeground}"
                                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"></TextBlock>
                    </StackPanel>
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Right" Style="{StaticResource CaptionCloseButtonStyle}" FontSize="14"
                            Command="{x:Static SystemCommands.CloseWindowCommand}" Content="&#xe607;"></Button>
                </Grid>
            </Border>

            <!--消息-->
            <TextBlock Text="" Foreground="{DynamicResource baseForeground}" FontSize="13" Grid.Row="1" HorizontalAlignment="Center" TextWrapping="WrapWithOverflow"
                       TextAlignment="Center" Margin="24,10,24,10" VerticalAlignment="Center" x:Name="msg"></TextBlock>

            <!--按钮-->
            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,20">
                <Button Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed" x:Name="ok" Content="{DynamicResource Yes}" Click="ok_Click" Width="88" Height="32"></Button>
                <Button Content="{DynamicResource No}" Visibility="Collapsed" Style="{StaticResource CommonButtonStyle}" x:Name="no" Margin="12,0,0,0" Width="88" Height="32" Click="no_Click"></Button>
                <Button Style="{StaticResource CommonButtonStyle}" Visibility="Collapsed" Content="{DynamicResource Close}" Click="ImageButton_Click" x:Name="cancel" Width="88" Height="32" Margin="12,0,0,0"></Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
