<!--作者：TT 时间:2023-03-14 23:27:58 描述：PackageEasy.Views.EndView界面 TANGMANGER-->
<UserControl x:Class="PackageEasy.Views.EndView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PackageEasy.Views"
             xmlns:controls="clr-namespace:PackageEasy.Controls.Controls;assembly=PackageEasy.Controls"
             xmlns:lang="clr-namespace:PackageEasy.Common.Data;assembly=PackageEasy.Common"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900" Foreground="{DynamicResource baseForeground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource appCanvasBrush}">
        <StackPanel Margin="24,20,24,24">
            <!--页头-->
            <TextBlock Text="{DynamicResource ProjectEnd}" Style="{StaticResource PageHeaderStyle}"></TextBlock>

            <!--卡片一：安装完成-->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" MaxWidth="960" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource PanelIconBoxStyle}">
                            <Path Style="{StaticResource PanelIconPathStyle}" Data="{StaticResource IconFlag}"></Path>
                        </Border>
                        <TextBlock Text="{DynamicResource EndCardInstall}" Style="{StaticResource PanelTitleStyle}"></TextBlock>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"></ColumnDefinition>
                            <ColumnDefinition Width="320"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource EndProcess}" Style="{StaticResource FormLabelStyle}"></TextBlock>
                        <ComboBox Grid.Column="1" Style="{StaticResource CommonComboBoxStyle}" HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding TargetFilesList}" SelectedItem="{Binding ApplicationName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></ComboBox>
                        <CheckBox Grid.Column="2" Style="{StaticResource SwitchCheckBoxStyle}" Margin="20,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding IsAutoRun,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Content="{DynamicResource EndStartProcess}"></CheckBox>

                        <TextBlock Grid.Row="1" Text="{DynamicResource EndParams}" Style="{StaticResource FormLabelStyle}" Margin="0,14,12,0"></TextBlock>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource CommonTextBox}" Margin="0,14,0,0" VerticalAlignment="Center"
                                 Text="{Binding RunParam,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>

                        <TextBlock Grid.Row="2" Text="{DynamicResource EndReadmeName}" Style="{StaticResource FormLabelStyle}" Margin="0,14,12,0"></TextBlock>
                        <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource CommonComboBoxStyle}" Margin="0,14,0,0" VerticalContentAlignment="Center"
                                  IsEnabled="{Binding IsShowReadme,UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding TargetFilesList}" SelectedItem="{Binding ReadMeName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></ComboBox>
                        <CheckBox Grid.Row="2" Grid.Column="2" Style="{StaticResource SwitchCheckBoxStyle}" Margin="20,14,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding IsShowReadme,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Content="{DynamicResource EndShowReadmeName}"></CheckBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!--卡片二：进程检测-->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"  MaxWidth="960" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource PanelIconBoxStyle}">
                            <Path Style="{StaticResource PanelIconPathStyle}" Data="{StaticResource IconBolt}"></Path>
                        </Border>
                        <TextBlock Text="{DynamicResource EndCardProcess}" Style="{StaticResource PanelTitleStyle}"></TextBlock>
                        <CheckBox Style="{StaticResource SwitchCheckBoxStyle}" Margin="20,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding IsEnableProcess,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Content="{DynamicResource EndUseCheckProcess}"></CheckBox>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource EndChcekProcessName}" Style="{StaticResource FormLabelStyle}"></TextBlock>
                        <controls:PlaceholderTextBox Grid.Column="1" Style="{StaticResource PlaceholderTextBoxStyle}" MinWidth="320" MaxWidth="620" HorizontalAlignment="Left"
                                                     Foreground="{DynamicResource baseForeground}" CaretBrush="{DynamicResource baseForeground}"
                                                     PlaceHolderText="{DynamicResource EndChcekProcessExample}" TextWrapping="Wrap" VerticalContentAlignment="Center"
                                                     IsEnabled="{Binding IsEnableProcess}"
                                                     Text="{Binding ProcessName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></controls:PlaceholderTextBox>

                        <TextBlock Grid.Row="1" Text="{DynamicResource EndInstallContent}" Style="{StaticResource FormLabelStyle}" Margin="0,12,12,0" VerticalAlignment="Top"></TextBlock>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource CommonTextBox}" Margin="0,12,0,0" MinHeight="60" MaxWidth="620" HorizontalAlignment="Left"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="6,5" AcceptsReturn="True"
                                 IsEnabled="{Binding IsEnableProcess}"
                                 Text="{Binding InstallProcessTips,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>

                        <TextBlock Grid.Row="2" Text="{DynamicResource EndUnInstallContent}" Style="{StaticResource FormLabelStyle}" Margin="0,12,12,0" VerticalAlignment="Top"></TextBlock>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource CommonTextBox}" Margin="0,12,0,0" MinHeight="60" MaxWidth="620" HorizontalAlignment="Left"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="6,5" AcceptsReturn="True"
                                 IsEnabled="{Binding IsEnableProcess}"
                                 Text="{Binding UninstallProcessTips,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!--卡片三：卸载事件-->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" MaxWidth="960" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource PanelIconBoxStyle}">
                            <Path Style="{StaticResource PanelIconPathStyle}" Data="{StaticResource IconClose}"></Path>
                        </Border>
                        <TextBlock Text="{DynamicResource EndCardUninstall}" Style="{StaticResource PanelTitleStyle}"></TextBlock>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource EndUnInstallTips}" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Top"></TextBlock>
                        <TextBox Grid.Column="1" Style="{StaticResource CommonTextBox}" MaxWidth="620" HorizontalAlignment="Left" MinHeight="48"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="6,5" AcceptsReturn="True"
                                 Text="{Binding UninstallTip,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>

                        <TextBlock Grid.Row="1" Text="{DynamicResource EndUnInstallMsg}" Style="{StaticResource FormLabelStyle}" Margin="0,12,12,0" VerticalAlignment="Top"></TextBlock>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource CommonTextBox}" Margin="0,12,0,0" MaxWidth="620" HorizontalAlignment="Left" MinHeight="48"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="6,5" AcceptsReturn="True"
                                 Text="{Binding UninstallMsg,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>

                        <TextBlock Grid.Row="2" Text="{DynamicResource EndBeforeUnInstall}" Style="{StaticResource FormLabelStyle}" Margin="0,14,12,0"></TextBlock>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <ComboBox Style="{StaticResource CommonComboBoxStyle}" Width="320" VerticalContentAlignment="Center"
                                      IsEnabled="{Binding IsBeforeUnInstall,UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding TargetFilesList}" SelectedItem="{Binding UnInstallApplication,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></ComboBox>
                            <CheckBox Style="{StaticResource SwitchCheckBoxStyle}" Margin="20,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding IsQuietInstall,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsBeforeUnInstall,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                      Content="{DynamicResource AssemblyQuietInstall}"></CheckBox>
                            <CheckBox Style="{StaticResource SwitchCheckBoxStyle}" Margin="20,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding IsBeforeUnInstall,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                      Content="{DynamicResource EndEnableBeforeUnInstall}"></CheckBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--保留项：使用解除安装程序（当前隐藏）-->
            <CheckBox Visibility="Collapsed" Content="{DynamicResource EndUnInstallMsg}"></CheckBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
