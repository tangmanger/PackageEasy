<!--作者：TT 时间:2023-03-15 22:20:45 描述：PackageEasy.Views.RegistryView界面 TANGMANGER-->
<UserControl x:Class="PackageEasy.Views.RegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PackageEasy.Views"
             xmlns:controls="https://dicgo.com/controls"
             xmlns:helpers="clr-namespace:PackageEasy.Common.Helpers;assembly=PackageEasy.Common"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" Foreground="{DynamicResource baseForeground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource appCanvasBrush}">
        <StackPanel Margin="24,20,24,24">
            <!--页头-->
            <TextBlock Text="{DynamicResource ProjectRegistry}" Style="{StaticResource PageHeaderStyle}"></TextBlock>
            <TextBlock Text="{DynamicResource RegistryPageDesc}" Style="{StaticResource PageSubHeaderStyle}" Margin="0,6,0,0"></TextBlock>

            <!--卡片一：文件关联-->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" MaxWidth="900" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource PanelIconBoxStyle}">
                            <Path Style="{StaticResource PanelIconPathStyle}" Data="{StaticResource IconRegistry}"></Path>
                        </Border>
                        <TextBlock Text="{DynamicResource RegistryCardAssoc}" Style="{StaticResource PanelTitleStyle}"></TextBlock>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"></ColumnDefinition>
                            <ColumnDefinition Width="260"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource RegistryFormat}" Style="{StaticResource FormLabelStyle}"></TextBlock>
                        <controls:PlaceholderTextBox Grid.Column="1" CaretBrush="{DynamicResource baseForeground}" Foreground="{DynamicResource baseForeground}"
                                                     PlaceHolderText="{DynamicResource RegistryExample}" Text="{Binding RegistryFormat,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource PlaceholderTextBoxStyle}" VerticalContentAlignment="Center"></controls:PlaceholderTextBox>

                        <CheckBox Grid.Column="2" Style="{StaticResource SwitchCheckBoxStyle}" Margin="20,0,0,0" VerticalAlignment="Center"
                                  Content="{DynamicResource RegistryCanChooseSection}" IsChecked="{Binding IsAsSelected}"></CheckBox>

                        <TextBlock Grid.Row="1" Text="{DynamicResource RegistryProcessName}" Style="{StaticResource FormLabelStyle}" Margin="0,14,12,0" VerticalAlignment="Top"></TextBlock>
                        <controls:PlaceholderTextBox Grid.Row="1" Grid.Column="1" CaretBrush="{DynamicResource baseForeground}" Foreground="{DynamicResource baseForeground}"
                                                     PlaceHolderText="{DynamicResource RegistryProcessExample}" MinHeight="32" TextWrapping="Wrap" Margin="0,14,0,0"
                                                     Style="{StaticResource PlaceholderTextBoxStyle}"
                                                     Text="{Binding ProcessName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></controls:PlaceholderTextBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!--卡片二：工程加密-->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" MaxWidth="900" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource PanelIconBoxStyle}">
                            <Path Style="{StaticResource PanelIconPathStyle}" Data="{StaticResource IconLock}"></Path>
                        </Border>
                        <TextBlock Text="{DynamicResource RegistryCardPassword}" Style="{StaticResource PanelTitleStyle}"></TextBlock>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"></ColumnDefinition>
                            <ColumnDefinition Width="260"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource RegistryPassword}" Style="{StaticResource FormLabelStyle}"></TextBlock>
                        <PasswordBox Grid.Column="1" Style="{StaticResource CommonPasswordBox}" IsEnabled="{Binding IsUsePassword}" MinHeight="32"
                                     Foreground="{DynamicResource baseForeground}" helpers:PasswordHelper.Attach="True"
                                     helpers:PasswordHelper.Password="{Binding Password,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch" VerticalContentAlignment="Center"></PasswordBox>
                        <CheckBox Grid.Column="2" Style="{StaticResource SwitchCheckBoxStyle}" Margin="20,0,0,0" VerticalAlignment="Center"
                                  Content="{DynamicResource RegistryEnablePassword}" IsChecked="{Binding IsUsePassword,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                    </Grid>
                    <TextBlock Text="{DynamicResource RegistryPasswordTip}" Style="{StaticResource FieldHintStyle}" Margin="142,12,0,0"></TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
