<UserControl x:Class="PackageEasy.Views.BaseInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PackageEasy.Views"
             xmlns:controls="https://dicgo.com/controls"
             xmlns:lang="clr-namespace:PackageEasy.Common.Data;assembly=PackageEasy.Common"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900" Foreground="{DynamicResource baseInfoForeground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource appCanvasBrush}">
        <StackPanel Margin="24,20,24,24" Grid.IsSharedSizeScope="True">
            <!--页头-->
            <TextBlock Text="{DynamicResource ProjectBaseInfo}" Style="{StaticResource PageHeaderStyle}"></TextBlock>

            <!--卡片一：应用标识-->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource PanelIconBoxStyle}">
                            <Path Style="{StaticResource PanelIconPathStyle}" Data="{StaticResource IconInfo}"></Path>
                        </Border>
                        <TextBlock Text="{DynamicResource BaseInfoCardAppInfo}" Style="{StaticResource PanelTitleStyle}"></TextBlock>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BaseInfoFieldLabel"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BaseInfoFieldLabel"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource BaseInfoAppName}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <TextBox Grid.Column="1" Style="{StaticResource CommonTextBox}" VerticalContentAlignment="Center"
                                 Text="{Binding ApplicationName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,24,14"></TextBox>

                        <TextBlock Grid.Column="2" Text="{DynamicResource BaseInfoCompany}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <TextBox Grid.Column="3" Style="{StaticResource CommonTextBox}" VerticalContentAlignment="Center"
                                 Text="{Binding CompanyName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"></TextBox>

                        <TextBlock Grid.Row="1" Text="{DynamicResource BaseInfoAppVersion}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,24,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <controls:PlaceholderTextBox Style="{StaticResource PlaceholderTextBoxStyle}" TipsTop="8"
                                                         PlaceHolderText="{DynamicResource BaseInfoAppVersionTips}"
                                                         Foreground="{DynamicResource baseInfoForeground}" CaretBrush="{DynamicResource baseInfoForeground}"
                                                         Text="{Binding ApplicationVersion,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center"></controls:PlaceholderTextBox>
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBoxStyle}" Margin="12,0,0,0"
                                      Content="{DynamicResource BaseInfoDisplayUninstall}"
                                      IsChecked="{Binding IsShowInUnInstall}"></CheckBox>
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource BaseInfoPublisher}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource CommonTextBox}" VerticalContentAlignment="Center"
                                 Text="{Binding ApplicationPublisher,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"></TextBox>

                        <TextBlock Grid.Row="2" Text="{DynamicResource BaseInfoFileVersion}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <controls:PlaceholderTextBox Grid.Row="2" Grid.Column="1" TipsTop="8" PlaceHolderText="{DynamicResource BaseInfoFileVersionTips}"
                                                     Style="{StaticResource PlaceholderTextBoxStyle}" CaretBrush="{DynamicResource baseInfoForeground}"
                                                     Foreground="{DynamicResource baseInfoForeground}" TextWrapping="Wrap" Margin="0,0,24,0"
                                                     Text="{Binding ProductVersion,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"></controls:PlaceholderTextBox>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource BaseInfoAppWeb}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource CommonTextBox}" VerticalContentAlignment="Center"
                                 Text="{Binding ApplicationUrl,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,0"></TextBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!--卡片二：安装位置-->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource PanelIconBoxStyle}">
                            <Path Style="{StaticResource PanelIconPathStyle}" Data="{StaticResource IconFolder}"></Path>
                        </Border>
                        <TextBlock Text="{DynamicResource BaseInfoCardInstall}" Style="{StaticResource PanelTitleStyle}"></TextBlock>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BaseInfoFieldLabel"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BaseInfoFieldLabel"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource BaseInfoDefaultDir}" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Top" Margin="0,8,12,14"></TextBlock>
                        <StackPanel Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,14">
                            <ComboBox IsEditable="False" MinWidth="120" Style="{StaticResource CommonComboBoxStyle}" VerticalContentAlignment="Center"
                                      SelectedItem="{Binding SystemDir}" ItemsSource="{Binding SystemDirList}"></ComboBox>
                            <TextBox Style="{StaticResource CommonTextBox}" VerticalContentAlignment="Center" MinWidth="110" Margin="8,0,0,0"
                                     Text="{Binding UserDirPath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>
                            <CheckBox Style="{StaticResource SwitchCheckBoxStyle}" Margin="5,0,0,0" VerticalAlignment="Center"
          Content="{DynamicResource BaseInfoCanChooseDir}" HorizontalAlignment="Left"
          IsChecked="{Binding CanUserChangeDir,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                        </StackPanel>



                        <TextBlock Grid.Row="1" Text="{DynamicResource BaseInfoOutPut}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <TextBox Grid.Row="1" MinWidth="120" Grid.Column="1" Style="{StaticResource CommonTextBox}" VerticalContentAlignment="Center" Margin="0,0,24,14"
                                 Text="{Binding AppOutPath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource BaseInfoInstallForALL}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <CheckBox Grid.Row="1" Grid.Column="3" Style="{StaticResource SwitchCheckBoxStyle}" Margin="0,0,0,14" VerticalAlignment="Center"
                                  Content="{DynamicResource Sure}" IsChecked="{Binding InstallForAll}"></CheckBox>

                        <TextBlock Grid.Row="2" Text="{DynamicResource BaseInfoWorkSapce}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" >

                            <StackPanel Orientation="Horizontal" >
                                <StackPanel  Orientation="Horizontal" IsEnabled="{Binding IsUseRelativePath,Converter={StaticResource BoolRevolveConverter}, ConverterParameter=1}">
                                    <TextBox Style="{StaticResource CommonTextBox}" VerticalContentAlignment="Center" TextWrapping="WrapWithOverflow" MinHeight="32"
                                         Text="{Binding WorkSpace,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="220" ></TextBox>
                                    <Button Style="{StaticResource BrowseButtonStyle}"  Command="{Binding SelectWorkSpaceCommand}"></Button>
                                </StackPanel>
                                <CheckBox Grid.Column="2" HorizontalAlignment="Left" Style="{StaticResource SwitchCheckBoxStyle}" Margin="15,0,0,0" VerticalAlignment="Center"
           Content="{DynamicResource BaseInfoUseRelative}" IsChecked="{Binding IsUseRelativePath}" Command="{Binding UseRelativeCommand}"></CheckBox>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!--卡片三：界面与语言-->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource PanelIconBoxStyle}">
                            <Path Style="{StaticResource PanelIconPathStyle}" Data="{StaticResource IconGlobe}"></Path>
                        </Border>
                        <TextBlock Text="{DynamicResource BaseInfoCardInterface}" Style="{StaticResource PanelTitleStyle}"></TextBlock>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BaseInfoFieldLabel"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BaseInfoFieldLabel"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource BaseInfoUserInterFace}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding UserFaceList}" SelectedItem="{Binding UserFaceSelectItem,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayName" Style="{StaticResource CommonComboBoxStyle}" VerticalContentAlignment="Center" Margin="0,0,24,14"></ComboBox>

                        <TextBlock Grid.Column="2" Text="{DynamicResource BaseInfoLanuageFile}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <Grid Grid.Column="3" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource CommonTextBox}" VerticalContentAlignment="Center"
                                     Text="{Binding LanguagePath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>
                            <Button Grid.Column="1" Style="{StaticResource BrowseButtonStyle}" Command="{Binding SelectLanguageCommand}" CommandParameter="1"></Button>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{DynamicResource BaseInfoButtonType}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                            <RadioButton Style="{StaticResource CommonRadioButtonStyle}" Foreground="{DynamicResource baseInfoForeground}"
                                         Content="{DynamicResource BaseInfoButtonTypeClassic}"
                                         IsChecked="{Binding ButtonType,ConverterParameter=1,Converter={StaticResource ButtonTypeToBoolConverter},Mode=OneWay}"
                                         Command="{Binding ButtonCommand}" CommandParameter="1"></RadioButton>
                            <RadioButton Style="{StaticResource CommonRadioButtonStyle}" Foreground="{DynamicResource baseInfoForeground}" Margin="24,0,0,0"
                                         Content="{DynamicResource BaseInfoButtonTypeCheck}"
                                         IsChecked="{Binding ButtonType,ConverterParameter=2,Converter={StaticResource ButtonTypeToBoolConverter},Mode=OneWay}"
                                         CommandParameter="2" Command="{Binding ButtonCommand}"></RadioButton>
                            <RadioButton Style="{StaticResource CommonRadioButtonStyle}" Foreground="{DynamicResource baseInfoForeground}" Margin="24,0,0,0"
                                         Content="{DynamicResource BaseInfoButtonTypeCircle}"
                                         IsChecked="{Binding ButtonType,ConverterParameter=3,Converter={StaticResource ButtonTypeToBoolConverter},Mode=OneWay}"
                                         CommandParameter="3" Command="{Binding ButtonCommand}"></RadioButton>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="{DynamicResource BaseInfoLanuageChoose}" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Top" Margin="0,6,12,0"></TextBlock>
                        <ItemsControl Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Top" Margin="0,6,0,0" ItemsSource="{Binding InstallList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel></WrapPanel>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,0,16,8" VerticalContentAlignment="Center" Foreground="{DynamicResource baseInfoForeground}"
                                              IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Content="{Binding LanguageName}"></CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!--卡片四：资源与输出-->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource PanelIconBoxStyle}">
                            <Path Style="{StaticResource PanelIconPathStyle}" Data="{StaticResource IconFile}"></Path>
                        </Border>
                        <TextBlock Text="{DynamicResource BaseInfoCardResource}" Style="{StaticResource PanelTitleStyle}"></TextBlock>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BaseInfoFieldLabel"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="BaseInfoFieldLabel"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource BaseInfoAppIcon}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <Grid Grid.Column="1" Margin="0,0,24,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource CommonTextBox}" VerticalContentAlignment="Center"
                                     Text="{Binding AppIconPath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>
                            <Button Grid.Column="1" Style="{StaticResource BrowseButtonStyle}" Command="{Binding SelectIconCommand}" CommandParameter="1"></Button>
                        </Grid>

                        <TextBlock Grid.Column="2" Text="{DynamicResource BaseInfoInstallIcon}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <Grid Grid.Column="3" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource CommonTextBox}" VerticalContentAlignment="Center"
                                     Text="{Binding InstallIconPath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>
                            <Button Grid.Column="1" Style="{StaticResource BrowseButtonStyle}" Command="{Binding SelectIconCommand}" CommandParameter="2"></Button>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{DynamicResource BaseInfoUnInstallIcon}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,24,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource CommonTextBox}" VerticalContentAlignment="Center"
                                     Text="{Binding UnInstallIconPath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>
                            <Button Grid.Column="1" Style="{StaticResource BrowseButtonStyle}" Command="{Binding SelectIconCommand}" CommandParameter="3"></Button>
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource BaseInfoCompressAlgo}" Style="{StaticResource FormLabelStyle}" Margin="0,0,12,14"></TextBlock>
                        <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding CompressAlgoList}" SelectedItem="{Binding ComPressAlgo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayName" Style="{StaticResource CommonComboBoxStyle}" VerticalContentAlignment="Center" Margin="0,0,0,14"></ComboBox>

                        <TextBlock Grid.Row="2" Text="{DynamicResource BaseInfoLiscense}" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Top" Margin="0,8,12,0"></TextBlock>
                        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource CommonTextBox}" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding Path=IsChecked,ElementName=licenseChecked}"
                                     Text="{Binding LicenseFilePath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>
                            <Button Grid.Column="1" Style="{StaticResource BrowseButtonStyle}" IsEnabled="{Binding Path=IsChecked,ElementName=licenseChecked}"
                                    Command="{Binding SelectedLicenseCommand}"></Button>
                            <CheckBox Grid.Column="2" x:Name="licenseChecked" Style="{StaticResource SwitchCheckBoxStyle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                      Content="{DynamicResource BaseInfoLiscenseCheck}"
                                      IsChecked="{Binding IsLicenseChecked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
