<controls:BaseControl x:Class="PackageEasy.Views.Tools.PlugInManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PackageEasy.Views.Tools"
             xmlns:controls="clr-namespace:PackageEasy.Controls.Controls;assembly=PackageEasy.Controls"
             xmlns:lang="clr-namespace:PackageEasy.Common.Data;assembly=PackageEasy.Common"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" Foreground="{DynamicResource baseForeground}">

    <Grid Background="{DynamicResource appCanvasBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding PlugIns}" Margin="16,16,16,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="120"></WrapPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:PlugInButton  Height="92" Margin="0,0,12,12" PlugInState="{Binding InstallState,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                               Command="{Binding DataContext.ExecuteCommand,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}" CommandParameter="{Binding }">
                            <controls:PlugInButton.Template>
                                <ControlTemplate TargetType="controls:PlugInButton">
                                    <Border x:Name="grid" Background="{DynamicResource MainWorkAreaBackgroud}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="1"
                                            CornerRadius="12" RenderTransformOrigin="0.5,0.5" Cursor="Hand">
                                        <Grid Margin="16,12" HorizontalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition></RowDefinition>
                                                <RowDefinition Height="Auto"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Border Width="34" Height="34" HorizontalAlignment="Center" CornerRadius="9" Background="{DynamicResource accentWeakBrush}"  VerticalAlignment="Top">
                                                <TextBlock Style="{StaticResource IconFontStyle}" FontSize="20" Foreground="{DynamicResource Accent}" Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding DisplayName}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource baseForeground}" HorizontalAlignment="Left"></TextBlock>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource accentLineBrush}" TargetName="grid"></Setter>
                                            <Setter Property="Background" Value="{DynamicResource surface2Brush}" TargetName="grid"></Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="true">
                                            <Setter Property="RenderTransform" Value="{StaticResource buttonScale}" TargetName="grid"></Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </controls:PlugInButton.Template>
                        </controls:PlugInButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</controls:BaseControl>
