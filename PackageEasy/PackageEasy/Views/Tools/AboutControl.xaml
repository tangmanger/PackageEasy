<controls:BaseControl x:Class="PackageEasy.Views.Tools.AboutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PackageEasy.Views.Tools"
             xmlns:controls="clr-namespace:PackageEasy.Controls.Controls;assembly=PackageEasy.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="grid" Background="{DynamicResource appCanvasBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource CardStyle}" Margin="16" MaxWidth="620" HorizontalAlignment="Left">
                <StackPanel Orientation="Vertical">
                    <!--标题-->
                    <StackPanel Orientation="Horizontal">
                        <Image Style="{StaticResource AppLogoStyle}" Width="44" Height="44"></Image>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource AboutSoftWare}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource mainForeground}"></TextBlock>
                            <TextBlock Text="PackageEasy" FontSize="12" Foreground="{DynamicResource textTertiaryBrush}" Margin="0,2,0,0"></TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!--版本-->
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock Text="{DynamicResource AboutSoftWareVersion}" Style="{StaticResource FieldLabelStyle}" Width="90"></TextBlock>
                        <TextBlock Text="{Binding Version}" FontSize="12.5" Foreground="{DynamicResource mainForeground}" Margin="8,0,0,0"></TextBlock>
                    </StackPanel>

                    <!--说明-->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource AboutSoftWareDescription}" Style="{StaticResource FieldLabelStyle}" Width="90" VerticalAlignment="Top"></TextBlock>
                        <TextBlock TextWrapping="WrapWithOverflow" Margin="8,0,0,0" MaxWidth="460" FontSize="12.5" LineHeight="20"
                                   Foreground="{DynamicResource textSecondaryBrush}"
                                   Text="{DynamicResource AboutSoftWareDescriptionInfo}"></TextBlock>
                    </StackPanel>

                    <!--GitHub-->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="GitHub" Style="{StaticResource FieldLabelStyle}" Width="90"></TextBlock>
                        <TextBlock FontSize="12.5" Margin="8,0,0,0">
                            <Hyperlink NavigateUri="https://github.com/tangmanger/PackageEasy" Command="{Binding NavigateCommand}" CommandParameter="{Binding Path=NavigateUri,RelativeSource={RelativeSource Mode=Self}}">PackageEasy</Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!--联系我-->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource AboutSoftWareConnectMe}" Style="{StaticResource FieldLabelStyle}" Width="90" VerticalAlignment="Top"></TextBlock>
                        <Image Margin="8,0,0,0" Width="100" Height="100" Source="/Resources/Images/wx.jpg"></Image>
                    </StackPanel>

                    <Border Style="{StaticResource RowSeparatorStyle}" Margin="0,16,0,12"></Border>
                    <TextBlock Text="{DynamicResource AboutSoftWareCopyRight}" FontSize="11.5" Foreground="{DynamicResource textTertiaryBrush}"></TextBlock>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</controls:BaseControl>
