<controls:BaseControl x:Class="PackageEasy.Views.Tools.SettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PackageEasy.Views.Tools"
             xmlns:controls="clr-namespace:PackageEasy.Controls.Controls;assembly=PackageEasy.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" Background="Transparent">

    <Grid Background="{DynamicResource appCanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!--左导航-->
        <Border Background="{DynamicResource shellBrush}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="8,14">
                <TextBlock Text="{DynamicResource ToolSettingControl}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource textTertiaryBrush}" Margin="10,0,0,10"></TextBlock>
                <RadioButton Style="{StaticResource SettingTableStyle}" Foreground="{DynamicResource mainForeground}" IsChecked="True" x:Name="nsis"
                             Content="{DynamicResource SettingNSIS}" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"></RadioButton>
                <RadioButton Style="{StaticResource SettingTableStyle}" Foreground="{DynamicResource mainForeground}" x:Name="theme"
                             Content="{DynamicResource SettingDisplay}" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"></RadioButton>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,16">
                <!--NSIS 设置-->
                <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsChecked,ElementName=nsis,Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource SettingCompilePath}" Style="{StaticResource FormLabelStyle}" Foreground="{DynamicResource mainForeground}"></TextBlock>
                        <TextBox Grid.Column="1" Style="{StaticResource CommonTextBox}" Text="{Binding MakensisPath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" MinWidth="160"></TextBox>
                        <Button Grid.Column="2" Style="{StaticResource BrowseButtonStyle}" Command="{Binding SetNisiCommand}"></Button>

                        <TextBlock Grid.Row="1" Text="{DynamicResource SettingNsisHelper}" Style="{StaticResource FormLabelStyle}" Foreground="{DynamicResource mainForeground}" Margin="0,12,12,0"></TextBlock>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource CommonTextBox}" Text="{Binding NSISHelperPath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" MinWidth="160" Margin="0,12,0,0"></TextBox>
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource BrowseButtonStyle}" Command="{Binding HelperCommand}" Margin="6,12,0,0"></Button>
                    </Grid>
                </Border>

                <!--显示设置-->
                <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsChecked,ElementName=theme,Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{DynamicResource SettingLanguage}" Style="{StaticResource FormLabelStyle}" Foreground="{DynamicResource mainForeground}"></TextBlock>
                        <ComboBox Grid.Column="1" MinWidth="160" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding LanguageTypes}" SelectedItem="{Binding SelectedLanguageType}" DisplayMemberPath="DisplayName" Style="{StaticResource CommonComboBoxStyle}"></ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</controls:BaseControl>
