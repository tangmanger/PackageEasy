<UserControl x:Class="PackageEasy.Views.OtherViews.LanguageFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PackageEasy.Views.OtherViews"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <!--卡片标题-->
        <StackPanel Orientation="Horizontal" Margin="16,14,16,10">
            <Border Style="{StaticResource PanelIconBoxStyle}">
                <Path Style="{StaticResource PanelIconPathStyle}" Data="{StaticResource IconGlobe}"></Path>
            </Border>
            <TextBlock Text="{DynamicResource MultiLanguage}" Style="{StaticResource PanelTitleStyle}"></TextBlock>
        </StackPanel>

        <DataGrid Grid.Row="1" Margin="8,0,8,0" ItemsSource="{Binding MultiFileList}" Style="{StaticResource DataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{DynamicResource MultiLanguageChoose}" Foreground="{DynamicResource DataGridForeground}" FontSize="11.5"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Foreground="{DynamicResource baseForeground}" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{DynamicResource MultiLanguage}" Foreground="{DynamicResource DataGridForeground}" FontSize="11.5"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Lang,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,3" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                      DisplayMemberPath="LanguageName" ItemsSource="{Binding DataContext.InstallLangList,RelativeSource={RelativeSource AncestorType=DataGrid}}" Style="{StaticResource CommonComboBoxStyle}"></ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{DynamicResource MultiLanguageTargetFile}" Foreground="{DynamicResource DataGridForeground}" FontSize="11.5"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource CommonComboBoxStyle}" Height="26" Margin="0,3" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                      SelectedItem="{Binding AssemblyFile,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="FilePath" ItemsSource="{Binding DataContext.FileList,RelativeSource={RelativeSource AncestorType=DataGrid}}"></ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn MinWidth="100">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{DynamicResource MultiLanguageTargetRootDir}" Foreground="{DynamicResource DataGridForeground}" FontSize="11.5"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource CommonComboBoxStyle}" x:Name="combox" Height="26" Margin="0,3"
                                      DisplayMemberPath="DisplayName"
                                      VerticalContentAlignment="Center"
                                      SelectedItem="{Binding TargetPath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding DataContext.TargetDirList,RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"></ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{DynamicResource MultiLanguageTargetDir}" Foreground="{DynamicResource DataGridForeground}" FontSize="11.5"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource CommonComboBoxStyle}" Height="26" Margin="0,3" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                      SelectedItem="{Binding TargetDir,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="FilePath" ItemsSource="{Binding DataContext.DirList,RelativeSource={RelativeSource AncestorType=DataGrid}}"></ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--页脚-->
        <Border Grid.Row="2" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource MultiLanguageAdd}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCommand}" MinWidth="80"></Button>
                <Button Content="{DynamicResource MultiLanguageDel}" Style="{StaticResource CommonButtonStyle}" Command="{Binding DelCommand}" Margin="8,0,0,0" MinWidth="80"></Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
