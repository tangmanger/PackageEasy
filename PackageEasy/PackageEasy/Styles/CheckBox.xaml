<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--复选框：15px 方框 + 主色勾-->
    <Style x:Key="CommonCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource mainForeground}"></Setter>
        <Setter Property="FontSize" Value="12.5"></Setter>
        <Setter Property="Cursor" Value="Hand"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="15" Height="15" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource borderStrongBrush}" Background="{DynamicResource MainWorkAreaBackgroud}" VerticalAlignment="Center">
                            <Grid>
                                <Path x:Name="check" Data="{DynamicResource IconCheck}" Stroke="{DynamicResource onAccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="9" Height="9" Visibility="Collapsed"></Path>
                                <Rectangle x:Name="dash" Width="7" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource onAccentBrush}" Visibility="Collapsed"></Rectangle>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="content" Margin="6,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"></ContentPresenter>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" TargetName="box"></Setter>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Accent}" TargetName="box"></Setter>
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" TargetName="box"></Setter>
                            <Setter Property="Visibility" Value="Visible" TargetName="check"></Setter>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter Property="Background" Value="{DynamicResource Accent}" TargetName="box"></Setter>
                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" TargetName="box"></Setter>
                            <Setter Property="Visibility" Value="Visible" TargetName="dash"></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--默认复选样式统一为新样式-->
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CommonCheckBoxStyle}"/>
</ResourceDictionary>
