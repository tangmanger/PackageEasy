<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--==========================================================
        卡片与排版通用样式（页面统一使用）
    ===========================================================-->
    <!--卡片：12 圆角、1px 描边、16 内边距-->
    <Style x:Key="CardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource MainWorkAreaBackgroud}"></Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource borderBrush}"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="CornerRadius" Value="12"></Setter>
        <Setter Property="Padding" Value="16"></Setter>
        <Setter Property="SnapsToDevicePixels" Value="True"></Setter>
    </Style>
    <!--内嵌小卡片（弱底，无阴影）-->
    <Style x:Key="SubCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{DynamicResource surface2Brush}"></Setter>
        <Setter Property="CornerRadius" Value="8"></Setter>
        <Setter Property="Padding" Value="12"></Setter>
    </Style>
    <!--页面标题-->
    <Style x:Key="PageHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18"></Setter>
        <Setter Property="FontWeight" Value="Bold"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource mainForeground}"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <!--页面副标题-->
    <Style x:Key="PageSubHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource textTertiaryBrush}"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <!--卡片区块标题-->
    <Style x:Key="SectionHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13"></Setter>
        <Setter Property="FontWeight" Value="SemiBold"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource mainForeground}"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <!--表单字段标签-->
    <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12.5"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource textSecondaryBrush}"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"></Setter>
    </Style>
    <!--字段说明小字-->
    <Style x:Key="FieldHintStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11.5"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource textTertiaryBrush}"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="TextWrapping" Value="Wrap"></Setter>
    </Style>
    <!--工具条容器-->
    <Style x:Key="ToolbarStyle" TargetType="{x:Type StackPanel}">
        <Setter Property="Orientation" Value="Horizontal"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Background" Value="Transparent"></Setter>
    </Style>
    <!--胶囊标签-->
    <Style x:Key="PillStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource accentWeakBrush}"></Setter>
        <Setter Property="CornerRadius" Value="10"></Setter>
        <Setter Property="Padding" Value="8,2"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <!--胶囊标签文字-->
    <Style x:Key="PillTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <!--状态圆点-->
    <Style x:Key="StatusDotStyle" TargetType="{x:Type Ellipse}">
        <Setter Property="Width" Value="8"></Setter>
        <Setter Property="Height" Value="8"></Setter>
        <Setter Property="Fill" Value="{DynamicResource okBrush}"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <!--类型徽标-->
    <Style x:Key="TypeBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource surface2Brush}"></Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource borderBrush}"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="CornerRadius" Value="4"></Setter>
        <Setter Property="Padding" Value="6,1"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <!--等宽文本（路径、日志）-->
    <Style x:Key="MonoTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"></Setter>
        <Setter Property="FontSize" Value="11.5"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource textSecondaryBrush}"></Setter>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <!--列表分隔线-->
    <Style x:Key="RowSeparatorStyle" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1"></Setter>
        <Setter Property="Background" Value="{DynamicResource borderBrush}"></Setter>
        <Setter Property="SnapsToDevicePixels" Value="True"></Setter>
    </Style>
    <!--表单标签：右对齐、右边距-->
    <Style x:Key="FormLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FieldLabelStyle}">
        <Setter Property="HorizontalAlignment" Value="Right"></Setter>
        <Setter Property="Margin" Value="0,0,12,0"></Setter>
    </Style>
    <!--面板标题图标块-->
    <Style x:Key="PanelIconBoxStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="26"></Setter>
        <Setter Property="Height" Value="26"></Setter>
        <Setter Property="CornerRadius" Value="7"></Setter>
        <Setter Property="Background" Value="{DynamicResource accentWeakBrush}"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <!--面板标题图标-->
    <Style x:Key="PanelIconPathStyle" TargetType="{x:Type Path}" BasedOn="{StaticResource IconPathSmallStyle}">
        <Setter Property="Stroke" Value="{DynamicResource Accent}"></Setter>
    </Style>
    <!--面板标题文字-->
    <Style x:Key="PanelTitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SectionHeaderStyle}">
        <Setter Property="Margin" Value="8,0,0,0"></Setter>
    </Style>
    <!--最近项目锁定图标：IsLock 为真时显示-->
    <Style x:Key="RecentLockIconStyle" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="12"></Setter>
        <Setter Property="Height" Value="12"></Setter>
        <Setter Property="Margin" Value="6,0,0,0"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Stretch" Value="Uniform"></Setter>
        <Setter Property="Fill" Value="Transparent"></Setter>
        <Setter Property="Stroke" Value="{DynamicResource warnBrush}"></Setter>
        <Setter Property="StrokeThickness" Value="1.4"></Setter>
        <Setter Property="StrokeStartLineCap" Value="Round"></Setter>
        <Setter Property="StrokeEndLineCap" Value="Round"></Setter>
        <Setter Property="StrokeLineJoin" Value="Round"></Setter>
        <Setter Property="Data" Value="{StaticResource IconLock}"></Setter>
        <Setter Property="Visibility" Value="Collapsed"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLock}" Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--最近项目空状态提示：列表为空时显示-->
    <Style x:Key="RecentEmptyHintStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FieldHintStyle}">
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="Margin" Value="0,24,0,24"></Setter>
        <Setter Property="Visibility" Value="Collapsed"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RecentlyList.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding RecentlyList}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
