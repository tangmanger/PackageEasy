<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--==========================================================
        对话框专用样式（编译进度窗口等）
    ===========================================================-->
    <!--日志列表项：无选中高亮-->
    <Style x:Key="CompileLogItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
        <Setter Property="Padding" Value="12,1"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter></ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--日志列表-->
    <Style x:Key="CompileLogListStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="BorderThickness" Value="0"></Setter>
        <Setter Property="Padding" Value="0,6"></Setter>
        <Setter Property="ItemContainerStyle" Value="{StaticResource CompileLogItemStyle}"></Setter>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"></Setter>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"></Setter>
    </Style>
    <!--日志行文本：错误行自动转危险色-->
    <Style x:Key="CompileLogTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"></Setter>
        <Setter Property="FontSize" Value="11.5"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource textSecondaryBrush}"></Setter>
        <Setter Property="TextWrapping" Value="Wrap"></Setter>
        <Setter Property="VerticalAlignment" Value="Top"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource dangerBrush}"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--日志时间戳-->
    <Style x:Key="CompileLogTimeTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CompileLogTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource textTertiaryBrush}"></Setter>
    </Style>
    <!--空日志占位-->
    <Style x:Key="CompileEmptyLogStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11.5"></Setter>
        <Setter Property="FontStyle" Value="Italic"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource textTertiaryBrush}"></Setter>
        <Setter Property="Margin" Value="12,8,12,0"></Setter>
        <Setter Property="VerticalAlignment" Value="Top"></Setter>
        <Setter Property="IsHitTestVisible" Value="False"></Setter>
        <Setter Property="Visibility" Value="Collapsed"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--状态圆点：运行中强调色、完成成功色、失败危险色-->
    <Style x:Key="CompileStatusDotStyle" TargetType="{x:Type Ellipse}" BasedOn="{StaticResource StatusDotStyle}">
        <Setter Property="Fill" Value="{DynamicResource Accent}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFinished}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource okBrush}"></Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource dangerBrush}"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--状态文本-->
    <Style x:Key="CompileStateTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13"></Setter>
        <Setter Property="FontWeight" Value="SemiBold"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource mainForeground}"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    <!--完成结果卡片：完成后显示，失败转危险底色-->
    <Style x:Key="CompileResultCardStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="10"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="Padding" Value="14"></Setter>
        <Setter Property="Opacity" Value="0.98"></Setter>
        <Setter Property="Visibility" Value="Collapsed"></Setter>
        <Setter Property="Background" Value="{DynamicResource okWeakBrush}"></Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource okBrush}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFinished}" Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                <Setter Property="Background" Value="{DynamicResource dangerWeakBrush}"></Setter>
                <Setter Property="BorderBrush" Value="{DynamicResource dangerBrush}"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--结果图标块-->
    <Style x:Key="CompileResultIconBoxStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="30"></Setter>
        <Setter Property="Height" Value="30"></Setter>
        <Setter Property="CornerRadius" Value="8"></Setter>
        <Setter Property="VerticalAlignment" Value="Top"></Setter>
        <Setter Property="Background" Value="{DynamicResource okBrush}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                <Setter Property="Background" Value="{DynamicResource dangerBrush}"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--结果图标：成功勾选、失败叉号-->
    <Style x:Key="CompileResultIconPathStyle" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="15"></Setter>
        <Setter Property="Height" Value="15"></Setter>
        <Setter Property="Stretch" Value="Uniform"></Setter>
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Stroke" Value="{DynamicResource onAccentBrush}"></Setter>
        <Setter Property="StrokeThickness" Value="2"></Setter>
        <Setter Property="Data" Value="{DynamicResource IconCheck}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                <Setter Property="Data" Value="{DynamicResource IconClose}"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--成功信息区：失败时隐藏-->
    <Style x:Key="CompileSuccessInfoStyle" TargetType="{x:Type Grid}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--失败摘要：失败时显示-->
    <Style x:Key="CompileErrorSummaryStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11.5"></Setter>
        <Setter Property="TextWrapping" Value="Wrap"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource dangerBrush}"></Setter>
        <Setter Property="Visibility" Value="Collapsed"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!--打开输出目录按钮：编译成功且未失败时可用-->
    <Style x:Key="CompileOpenFolderButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="MinWidth" Value="110"></Setter>
        <Setter Property="Height" Value="32"></Setter>
        <Setter Property="IsEnabled" Value="False"></Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFinished}" Value="True"></Condition>
                    <Condition Binding="{Binding IsFailed}" Value="False"></Condition>
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="True"></Setter>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <!--软件图标（品牌 Logo）：标题栏与关于页统一使用-->
    <Style x:Key="AppLogoStyle" TargetType="{x:Type Image}">
        <Setter Property="Source" Value="/Resources/Images/tools.png"></Setter>
        <Setter Property="Stretch" Value="Uniform"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="SnapsToDevicePixels" Value="True"></Setter>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"></Setter>
    </Style>
</ResourceDictionary>
