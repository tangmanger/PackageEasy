<Window x:Class="PackageEasy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:PackageEasy"
        xmlns:PackageControls="clr-namespace:PackageEasy.Common.Controls;assembly=PackageEasy.Common"
        mc:Ignorable="d"
        Title="Package Easy Bate v1.0"    Background="{DynamicResource shellBrush}" WindowStyle="None" Height="800" Width="1280" MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen" DataContext="{Binding Main,Source={StaticResource locator}}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                    GlassFrameThickness="0,0,0,1"
                    NonClientFrameEdges="None"
                    CornerRadius="8"
                    ResizeBorderThickness="4"
                    UseAeroCaptionButtons="False"
                     />

    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenFileCommand}" />
        <KeyBinding Modifiers="Control" Key="W" Command="{Binding CloseTableCommand}"/>
        <KeyBinding Modifiers="Control" Key="E" Command="{Binding ExportScriptCommand}"/>
        <KeyBinding Modifiers="Control" Key="I" Command="{Binding ImportScriptCommand}"/>
        <KeyBinding Modifiers="Control" Key="B" Command="{Binding CompileCommand}"/>
    </Window.InputBindings>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" ></i:InvokeCommandAction>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Background="{DynamicResource shellBrush}" SnapsToDevicePixels="True">
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="44"></RowDefinition>
                <RowDefinition Height="38"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <!--标题栏-->
            <Border Background="{DynamicResource shellBrush}" CornerRadius="0">
                <Grid WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Grid.Column="0">
                        <Image Style="{StaticResource AppLogoStyle}" Width="22" Height="22" Margin="14,0,0,0"></Image>
                        <Menu Style="{StaticResource MainMenuStyle}" Margin="12,0,0,0" VerticalAlignment="Center">
                            <MenuItem Height="26" MinWidth="40" d:Header="文件" Header="{DynamicResource MainFile}">
                                <MenuItem Language="" d:Header="新建" Header="{DynamicResource MainNewFile}" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N">
                                </MenuItem>
                                <MenuItem d:Header="打开.." Header="{DynamicResource MainOpen}"  Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"></MenuItem>
                                <MenuItem d:Header="关闭" Header="{DynamicResource MainClose}" IsEnabled="{Binding IsMenuCanEdit}" Command="{Binding CloseTableCommand}"   InputGestureText="Ctrl+W">
                                </MenuItem>
                                <Separator Style="{StaticResource sep}"/>
                                <MenuItem d:Header="保存" Header="{DynamicResource MainSave}" IsEnabled="{Binding IsMenuCanEdit}"    InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"></MenuItem>
                                <MenuItem d:Header="另存为.." Header="{DynamicResource MainSaveAs}" IsEnabled="{Binding IsMenuCanEdit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"     Command="{Binding SaveAsCommand}">
                                </MenuItem>
                                <Separator Style="{StaticResource sep}"/>
                                <MenuItem d:Header="导出脚本" Header="{DynamicResource MainExportScript}"  IsEnabled="{Binding IsMenuCanEdit}"    Command="{Binding ExportScriptCommand}" InputGestureText="Ctrl+E"></MenuItem>
                                <MenuItem d:Header="打开脚本"   Header="{DynamicResource MainImportScript}" Command="{Binding ImportScriptCommand}" InputGestureText="Ctrl+I"></MenuItem>
                                <Separator Style="{StaticResource sep}"/>
                                <MenuItem d:Header="退出" Header="{DynamicResource MainExit}" Command="{Binding ExitCommand}"/>
                            </MenuItem>
                            <MenuItem Height="26" MinWidth="40" d:Header="生成" Header="{DynamicResource MainBulid}">
                                <MenuItem d:Header="编译" IsEnabled="{Binding IsMenuCanEdit}"  Header="{DynamicResource MainCompile}"  Command="{Binding CompileCommand}" InputGestureText="Ctrl+B"  >
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource IconFontStyle}" FontSize="12" Text="&#xe613;"></TextBlock>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Height="26" MinWidth="40" d:Header="工具" Header="{DynamicResource MainTools}">
                                <MenuItem d:Header="设置" Header="{DynamicResource MainSetting}" Command="{Binding SettingCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource IconFontStyle}" FontSize="14" Text="&#xe68f;"></TextBlock>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Height="26" MinWidth="40" d:Header="扩展" Header="{DynamicResource MainExtension}">
                                <MenuItem d:Header="管理扩展" Header="{DynamicResource MainManageExtension}" Command="{Binding PlugInManagerCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource IconFontStyle}" FontSize="14" Text="&#xe634;"></TextBlock>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Height="26" MinWidth="40" d:Header="数据" Header="{DynamicResource MainDataStore}">
                                <MenuItem d:Header="路径管理" Header="{DynamicResource MainTargetPath}" Command="{Binding TargetPathCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource IconFontStyle}" FontSize="14" Text="&#xe672;"></TextBlock>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Height="26" MinWidth="40" d:Header="帮助" Header="{DynamicResource MainHelp}">
                                <MenuItem d:Header="关于PackageEasy" Header="{DynamicResource MainAbout}" Command="{Binding AboutCommand}">
                                </MenuItem>
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                    <StackPanel WindowChrome.IsHitTestVisibleInChrome="True"  Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="2">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Command="{Binding ToggleThemeCommand}" VerticalAlignment="Center" Margin="0,0,6,0"></Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Command="{x:Static SystemCommands.MinimizeWindowCommand}"  Content="&#xea6a;"></Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Command="{x:Static SystemCommands.MaximizeWindowCommand}"  x:Name="max" Content="&#xe65d;"></Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Command="{x:Static SystemCommands.RestoreWindowCommand}" x:Name="normal" Content="&#xe692;"></Button>
                        <Button Style="{StaticResource CaptionCloseButtonStyle}" Command="{x:Static SystemCommands.CloseWindowCommand}" Content="&#xe607;"></Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!--页签条-->
            <Border Grid.Row="1" Background="{DynamicResource mainTablePanelBrushes}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,0,0,1">

                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <PackageControls:IconRadioButton ClickMode="Press" Width="139" Margin="0,0,0,0" VerticalAlignment="Stretch" GroupName="title" IsShowClose="False" d:Content="首页" Content="{DynamicResource MainHome}" Command="{Binding BackToHomeCommand}"  IsChecked="{Binding IsActived,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Icon="&#xe8ff;"   Style="{StaticResource IconRadioButtonStyle}">
                    </PackageControls:IconRadioButton>
                    <!--  Navigation frame  -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" Margin="0,0,0,0"  x:Name="scroller"  Style="{StaticResource for_scrollviewer1}">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding TableList}" MouseWheel="ItemsControl_MouseWheel" Margin="0,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"></StackPanel>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ItemsPresenter/>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <PackageControls:IconRadioButton Margin="1,0,0,0" VerticalAlignment="Stretch" IsShowClose="True" MinWidth="120" Width="auto" MaxWidth="200" GroupName="title" CloseCommand="{Binding Path=DataContext.CloseCommand,RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Command="{Binding Path=DataContext.SwitchProjectCommand,RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding }"  Style="{StaticResource IconRadioButtonStyle}" Icon="&#xe607;" IsChecked="{Binding IsActive,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Content="{Binding ProjectName}"></PackageControls:IconRadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource GhostButtonStyle}" Width="30" Height="30" MinWidth="30" Padding="0" Margin="2,0,8,0" VerticalAlignment="Center" Focusable="False" Command="{Binding NewProjectCommand}" ToolTip="{DynamicResource MainNewFile}">
                                <Path Style="{StaticResource IconPathStyle}" Width="14" Height="14" Stroke="{DynamicResource textSecondaryBrush}" Data="{StaticResource IconPlus}"></Path>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="{DynamicResource appCanvasBrush}">
                <ContentControl  Content="{Binding WorkView}" Background="Transparent"></ContentControl>
            </Border>
        </Grid>
    </Border>
</Window>
