<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--==========================================================
        亮色主题令牌（对齐 Docuuments/PackageEasy-UI.html）
        画布 #F1F4F9 / 卡片 #FFFFFF / 主色 #2563EB
    ===========================================================-->
    <!--结构-->
    <SolidColorBrush x:Key="shellBrush" Color="#F5F7FA"></SolidColorBrush>
    <SolidColorBrush x:Key="appCanvasBrush" Color="#F1F4F9"></SolidColorBrush>
    <SolidColorBrush x:Key="surface2Brush" Color="#F7F9FC"></SolidColorBrush>
    <SolidColorBrush x:Key="surface3Brush" Color="#EDF1F7"></SolidColorBrush>
    <SolidColorBrush x:Key="borderBrush" Color="#E4E9F0"></SolidColorBrush>
    <SolidColorBrush x:Key="borderStrongBrush" Color="#CFD8E3"></SolidColorBrush>
    <!--文字-->
    <SolidColorBrush x:Key="mainForeground" Color="#0F1728"></SolidColorBrush>
    <SolidColorBrush x:Key="textSecondaryBrush" Color="#4A5568"></SolidColorBrush>
    <SolidColorBrush x:Key="textTertiaryBrush" Color="#8792A5"></SolidColorBrush>
    <SolidColorBrush x:Key="menuDisabledForground" Color="#8792A5"></SolidColorBrush>
    <!--强调/语义-->
    <Color x:Key="AccentColor">#FF2563EB</Color>
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="accentWeakBrush" Color="#EDF3FF"></SolidColorBrush>
    <SolidColorBrush x:Key="accentLineBrush" Color="#C2D5FB"></SolidColorBrush>
    <SolidColorBrush x:Key="onAccentBrush" Color="#FFFFFF"></SolidColorBrush>
    <SolidColorBrush x:Key="okBrush" Color="#0E7A57"></SolidColorBrush>
    <SolidColorBrush x:Key="okWeakBrush" Color="#E4F5EE"></SolidColorBrush>
    <SolidColorBrush x:Key="warnBrush" Color="#A15C07"></SolidColorBrush>
    <SolidColorBrush x:Key="warnWeakBrush" Color="#FDF2E1"></SolidColorBrush>
    <SolidColorBrush x:Key="dangerBrush" Color="#C0392B"></SolidColorBrush>
    <SolidColorBrush x:Key="dangerWeakBrush" Color="#FCEBE9"></SolidColorBrush>
    <!--基础颜色（键名保持不变）-->
    <SolidColorBrush x:Key="MainWorkAreaBackgroud" Color="#FFFFFF"></SolidColorBrush>
    <SolidColorBrush x:Key="MainWindowBorderBrush" Color="#E4E9F0"></SolidColorBrush>
    <SolidColorBrush x:Key="menuOverBrush" Color="#EDF1F7"></SolidColorBrush>
    <SolidColorBrush x:Key="menuBackBrush" Color="#FFFFFF"></SolidColorBrush>
    <SolidColorBrush x:Key="menuLineStep" Color="#E4E9F0"></SolidColorBrush>
    <SolidColorBrush x:Key="menuOverBorderBrush" Color="#E4E9F0"></SolidColorBrush>
    <SolidColorBrush x:Key="menuBorderBrush" Color="#E4E9F0"></SolidColorBrush>
    <SolidColorBrush x:Key="watingBackground" Color="#0F1728"></SolidColorBrush>
    <SolidColorBrush x:Key="baseForeground" Color="#0F1728"></SolidColorBrush>
    <SolidColorBrush x:Key="progressColoBrush" Color="#2563EB" />
    <!--button-->
    <SolidColorBrush x:Key="CommonButtonBackgroundBrush" Color="#FFFFFF"></SolidColorBrush>
    <SolidColorBrush x:Key="CommonButtonBorderBrush" Color="#CFD8E3"></SolidColorBrush>
    <SolidColorBrush x:Key="CommonButtonForeground" Color="#0F1728"></SolidColorBrush>
    <!--SelecetRadioButtonStyle-->
    <SolidColorBrush x:Key="selecetRadioIsCheckedForeground" Color="#2563EB" />
    <SolidColorBrush x:Key="selecetRadioIsCheckedBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="selecetRadioForeground" Color="#4A5568" />
    <!--COMBOX-->
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundHover" Color="#F7F9FC" />
    <SolidColorBrush x:Key="InputBorder" Color="#E4E9F0" />
    <SolidColorBrush x:Key="InputBorderHover" Color="#CFD8E3" />
    <SolidColorBrush x:Key="InputText" Color="#0F1728" />
    <SolidColorBrush x:Key="InputTextHover" Color="#0F1728" />
    <SolidColorBrush x:Key="InputTextDisabled" Color="#8792A5" />
    <!--CommonTextBox-->
    <SolidColorBrush x:Key="commonTextBoxBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="commonTextBoxBorderBrush" Color="#CFD8E3" />
    <SolidColorBrush x:Key="commonDisableTextBoxBackground" Color="#F7F9FC"></SolidColorBrush>
    <SolidColorBrush x:Key="commonTextBoxForeground" Color="#0F1728"></SolidColorBrush>
    <!--ResultLightView-->
    <SolidColorBrush x:Key="resultLightViewForeground" Color="#8792A5"></SolidColorBrush>
    <SolidColorBrush x:Key="DataGridForeground" Color="#0F1728"></SolidColorBrush>
    <!--DataGridStyle-->
    <SolidColorBrush x:Key="datagridLinesBrush" Color="#E4E9F0" />
    <SolidColorBrush x:Key="datagridColumnHeaderBackground" Color="#F7F9FC" />
    <SolidColorBrush x:Key="datagridColumnHeaderForeground" Color="#4A5568" />
    <SolidColorBrush x:Key="datagridRowMouseOver" Color="#F7F9FC" />
    <SolidColorBrush x:Key="datagridRowSelected" Color="#EDF3FF" />
    <!--主页颜色-->
    <SolidColorBrush Color="#F5F7FA" x:Key="titleColoBrushes"></SolidColorBrush>
    <SolidColorBrush Color="#F5F7FA" x:Key="mainTablePanelBrushes" ></SolidColorBrush>
    <SolidColorBrush x:Key="mainOperateButtonBrushes" Color="#4A5568"></SolidColorBrush>
    <SolidColorBrush x:Key="menuForeground" Color="#0F1728"></SolidColorBrush>
    <!--样式标题颜色（页签）-->
    <SolidColorBrush x:Key="iconRadioButtonBackground" Color="#F5F7FA"></SolidColorBrush>
    <SolidColorBrush x:Key="iconRadioButtonForeground" Color="#4A5568"></SolidColorBrush>
    <SolidColorBrush x:Key="iconRadioButtonMouseOverBackground" Color="#EDF1F7"></SolidColorBrush>
    <SolidColorBrush x:Key="iconRadioButtonCheckBackground" Color="#FFFFFF"></SolidColorBrush>
    <SolidColorBrush x:Key="iconRadioButtonCheckForeground" Color="#0F1728"></SolidColorBrush>
    <!--新建程序界面-->
    <SolidColorBrush x:Key="projectNewCreateBackground" Color="#FFFFFF"></SolidColorBrush>
    <SolidColorBrush x:Key="projectNewCreateForeground" Color="#0F1728"></SolidColorBrush>
    <SolidColorBrush x:Key="projectNewForeground" Color="#4A5568"></SolidColorBrush>
    <SolidColorBrush x:Key="projectNewCreateIsMouseOver" Color="#F7F9FC"></SolidColorBrush>
    <!--下拉框颜色-->
    <SolidColorBrush x:Key="dropComboxArrowBackground" Color="#EDF1F7"></SolidColorBrush>
    <!--ShowWindow颜色-->
    <SolidColorBrush x:Key="showWindowsBottonBackground" Color="#F5F7FA"></SolidColorBrush>
    <!--SettingControl-->
    <SolidColorBrush x:Key="settingControlBottonBackground" Color="#EDF3FF"></SolidColorBrush>
    <!--插件鼠标移上颜色-->
    <SolidColorBrush x:Key="pluginMouseOverBackground" Color="#F7F9FC" ></SolidColorBrush>
    <!--PasswordStyle-->
    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#CFD8E3"/>
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#2563EB"/>
    <!--基础页面颜色-->
    <SolidColorBrush x:Key="baseInfoForeground" Color="#0F1728"></SolidColorBrush>

    <!--TableControl（内部下划线页签）-->
    <SolidColorBrush x:Key="TabItem.Foreground" Color="#4A5568"></SolidColorBrush>
    <SolidColorBrush x:Key="TabItem.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Background" Color="#EDF1F7">
    </SolidColorBrush>
    <SolidColorBrush x:Key="TabItem.MouseOver.Border" Color="#EDF1F7"/>
    <SolidColorBrush x:Key="TabItem.Selected.Foreground" Color="#0F1728"/>
    <SolidColorBrush x:Key="TabItem.Selected.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="TabItem.Selected.Border" Color="#2563EB"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Border" Color="Transparent"/>
    <!--目标路径-->
    <SolidColorBrush x:Key="TargetPathControl.AddBorder.Background" Color="#F7F9FC"></SolidColorBrush>
    <SolidColorBrush x:Key="TargetPathControl.WorkBackground" Color="#FFFFFF"></SolidColorBrush>
</ResourceDictionary>
