<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--==========================================================
        暗色主题令牌（对齐 Docuuments/PackageEasy-UI.html）
        画布 #0F1218 / 卡片 #181C24 / 主色 #6C9BFF
    ===========================================================-->
    <!--结构-->
    <SolidColorBrush x:Key="shellBrush" Color="#12151B"></SolidColorBrush>
    <SolidColorBrush x:Key="appCanvasBrush" Color="#0F1218"></SolidColorBrush>
    <SolidColorBrush x:Key="surface2Brush" Color="#1D222C"></SolidColorBrush>
    <SolidColorBrush x:Key="surface3Brush" Color="#252B37"></SolidColorBrush>
    <SolidColorBrush x:Key="borderBrush" Color="#262D3A"></SolidColorBrush>
    <SolidColorBrush x:Key="borderStrongBrush" Color="#3A4353"></SolidColorBrush>
    <!--文字-->
    <SolidColorBrush x:Key="mainForeground" Color="#E8EDF5"></SolidColorBrush>
    <SolidColorBrush x:Key="textSecondaryBrush" Color="#A6B0C0"></SolidColorBrush>
    <SolidColorBrush x:Key="textTertiaryBrush" Color="#78838F"></SolidColorBrush>
    <SolidColorBrush x:Key="menuDisabledForground" Color="#78838F"></SolidColorBrush>
    <!--强调/语义-->
    <Color x:Key="AccentColor">#FF6C9BFF</Color>
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="accentWeakBrush" Color="#1B2540"></SolidColorBrush>
    <SolidColorBrush x:Key="accentLineBrush" Color="#33436E"></SolidColorBrush>
    <SolidColorBrush x:Key="onAccentBrush" Color="#0A1020"></SolidColorBrush>
    <SolidColorBrush x:Key="okBrush" Color="#4EC08D"></SolidColorBrush>
    <SolidColorBrush x:Key="okWeakBrush" Color="#14291F"></SolidColorBrush>
    <SolidColorBrush x:Key="warnBrush" Color="#DFAE6A"></SolidColorBrush>
    <SolidColorBrush x:Key="warnWeakBrush" Color="#2A2318"></SolidColorBrush>
    <SolidColorBrush x:Key="dangerBrush" Color="#F08473"></SolidColorBrush>
    <SolidColorBrush x:Key="dangerWeakBrush" Color="#2C1C19"></SolidColorBrush>
    <!--基础颜色（键名保持不变）-->
    <SolidColorBrush x:Key="MainWorkAreaBackgroud" Color="#181C24"></SolidColorBrush>
    <SolidColorBrush x:Key="MainWindowBorderBrush" Color="#262D3A"></SolidColorBrush>
    <SolidColorBrush x:Key="menuOverBrush" Color="#252B37"></SolidColorBrush>
    <SolidColorBrush x:Key="menuBackBrush" Color="#181C24"></SolidColorBrush>
    <SolidColorBrush x:Key="menuLineStep" Color="#262D3A"></SolidColorBrush>
    <SolidColorBrush x:Key="menuOverBorderBrush" Color="#262D3A"></SolidColorBrush>
    <SolidColorBrush x:Key="menuBorderBrush" Color="#262D3A"></SolidColorBrush>
    <SolidColorBrush x:Key="watingBackground" Color="#000000"></SolidColorBrush>
    <SolidColorBrush x:Key="baseForeground" Color="#E8EDF5"></SolidColorBrush>
    <SolidColorBrush x:Key="progressColoBrush" Color="#6C9BFF" />
    <!--button-->
    <SolidColorBrush x:Key="CommonButtonBackgroundBrush" Color="#1D222C"></SolidColorBrush>
    <SolidColorBrush x:Key="CommonButtonBorderBrush" Color="#3A4353"></SolidColorBrush>
    <SolidColorBrush x:Key="CommonButtonForeground" Color="#E8EDF5"></SolidColorBrush>
    <!--SelecetRadioButtonStyle-->
    <SolidColorBrush x:Key="selecetRadioIsCheckedForeground" Color="#6C9BFF" />
    <SolidColorBrush x:Key="selecetRadioIsCheckedBackground" Color="#252B37" />
    <SolidColorBrush x:Key="selecetRadioForeground" Color="#A6B0C0" />
    <!--COMBOX-->
    <SolidColorBrush x:Key="InputBackground" Color="#181C24" />
    <SolidColorBrush x:Key="InputBackgroundHover" Color="#1D222C" />
    <SolidColorBrush x:Key="InputBorder" Color="#262D3A" />
    <SolidColorBrush x:Key="InputBorderHover" Color="#3A4353" />
    <SolidColorBrush x:Key="InputText" Color="#E8EDF5" />
    <SolidColorBrush x:Key="InputTextHover" Color="#E8EDF5" />
    <SolidColorBrush x:Key="InputTextDisabled" Color="#78838F" />
    <!--CommonTextBox-->
    <SolidColorBrush x:Key="commonTextBoxBackground" Color="#181C24" />
    <SolidColorBrush x:Key="commonTextBoxBorderBrush" Color="#3A4353" />
    <SolidColorBrush x:Key="commonDisableTextBoxBackground" Color="#1D222C"></SolidColorBrush>
    <SolidColorBrush x:Key="commonTextBoxForeground" Color="#E8EDF5"></SolidColorBrush>
    <!--ResultLightView-->
    <SolidColorBrush x:Key="resultLightViewForeground" Color="#78838F"></SolidColorBrush>
    <SolidColorBrush x:Key="DataGridForeground" Color="#E8EDF5"></SolidColorBrush>
    <!--DataGridStyle-->
    <SolidColorBrush x:Key="datagridLinesBrush" Color="#262D3A" />
    <SolidColorBrush x:Key="datagridColumnHeaderBackground" Color="#1D222C" />
    <SolidColorBrush x:Key="datagridColumnHeaderForeground" Color="#A6B0C0" />
    <SolidColorBrush x:Key="datagridRowMouseOver" Color="#1D222C" />
    <SolidColorBrush x:Key="datagridRowSelected" Color="#1B2540" />
    <!--主页颜色-->
    <SolidColorBrush Color="#12151B" x:Key="titleColoBrushes"></SolidColorBrush>
    <SolidColorBrush Color="#12151B" x:Key="mainTablePanelBrushes" ></SolidColorBrush>
    <SolidColorBrush x:Key="mainOperateButtonBrushes" Color="#A6B0C0"></SolidColorBrush>
    <SolidColorBrush x:Key="menuForeground" Color="#E8EDF5"></SolidColorBrush>
    <!--样式标题颜色（页签）-->
    <SolidColorBrush x:Key="iconRadioButtonBackground" Color="#12151B"></SolidColorBrush>
    <SolidColorBrush x:Key="iconRadioButtonForeground" Color="#A6B0C0"></SolidColorBrush>
    <SolidColorBrush x:Key="iconRadioButtonMouseOverBackground" Color="#252B37"></SolidColorBrush>
    <SolidColorBrush x:Key="iconRadioButtonCheckBackground" Color="#181C24"></SolidColorBrush>
    <SolidColorBrush x:Key="iconRadioButtonCheckForeground" Color="#E8EDF5"></SolidColorBrush>
    <!--新建程序界面-->
    <SolidColorBrush x:Key="projectNewCreateBackground" Color="#1D222C"></SolidColorBrush>
    <SolidColorBrush x:Key="projectNewCreateForeground" Color="#E8EDF5"></SolidColorBrush>
    <SolidColorBrush x:Key="projectNewForeground" Color="#A6B0C0"></SolidColorBrush>
    <SolidColorBrush x:Key="projectNewCreateIsMouseOver" Color="#252B37"></SolidColorBrush>
    <!--下拉框颜色-->
    <SolidColorBrush x:Key="dropComboxArrowBackground" Color="#252B37"></SolidColorBrush>
    <!--ShowWindow颜色-->
    <SolidColorBrush x:Key="showWindowsBottonBackground" Color="#12151B"></SolidColorBrush>
    <!--SettingControl-->
    <SolidColorBrush x:Key="settingControlBottonBackground" Color="#1B2540"></SolidColorBrush>
    <!--插件鼠标移上颜色-->
    <SolidColorBrush x:Key="pluginMouseOverBackground" Color="#252B37" ></SolidColorBrush>
    <!--PasswordStyle-->
    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#3A4353"/>
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="#6C9BFF"/>
    <!--基础页面颜色-->
    <SolidColorBrush x:Key="baseInfoForeground" Color="#E8EDF5"></SolidColorBrush>

    <!--TableControl（内部下划线页签）-->
    <SolidColorBrush x:Key="TabItem.Foreground" Color="#A6B0C0"></SolidColorBrush>
    <SolidColorBrush x:Key="TabItem.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Background" Color="#252B37">
    </SolidColorBrush>
    <SolidColorBrush x:Key="TabItem.MouseOver.Border" Color="#252B37"/>
    <SolidColorBrush x:Key="TabItem.Selected.Foreground" Color="#E8EDF5"/>
    <SolidColorBrush x:Key="TabItem.Selected.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="TabItem.Selected.Border" Color="#6C9BFF"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Border" Color="Transparent"/>
    <!--目标路径-->
    <SolidColorBrush x:Key="TargetPathControl.AddBorder.Background" Color="#1D222C"></SolidColorBrush>
    <SolidColorBrush x:Key="TargetPathControl.WorkBackground" Color="#181C24"></SolidColorBrush>
</ResourceDictionary>
